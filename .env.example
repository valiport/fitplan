# Supabase → Project Settings → API
# Public project URL and anon/publishable browser key only. Never put service_role here.
# Kopiere diese Datei als .env.local und trage dort deine Werte ein.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
