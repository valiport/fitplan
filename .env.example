# Supabase → Project Settings → API
# Public project URL and anon/publishable browser key only. Never put service_role here.
# Kopiere diese Datei als .env.local und trage dort deine Werte ein.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Stripe-Checkout (Pro-Abo). Öffentliche Preis-IDs (price_…) sind KEINE Secrets —
# ohne beide Werte bleibt der Pro-Kauf im Demo-Modus (lokal simuliert).
# Die geheimen Keys (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# SUPABASE_SERVICE_ROLE_KEY) gehören NUR in die Netlify-Umgebung, nie hierher.
VITE_STRIPE_PRICE_MONTHLY=price_monthly_placeholder
VITE_STRIPE_PRICE_YEARLY=price_yearly_placeholder
